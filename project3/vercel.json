{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/client/index.html" },
    { "src": "/(assets/.*)", "dest": "/client/$1" },
    { "src": "/(icons/.*)", "dest": "/client/$1" },
    {
      "src": "/sw\\.js",
      "dest": "/client/sw.js",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    { "src": "/manifest\\.webmanifest", "dest": "/client/manifest.webmanifest" },
    { "src": "/favicon\\.ico", "dest": "/client/icons/icon-192.png" },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ]
}
